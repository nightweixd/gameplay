{
  "name": "geniuscode-gameplay",
  "version": "1.0.0",
  "private": true,
  "description": "GeniusCode+ browser game playground for young builders and coders.",
  "author": "nightweixd",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tests/gameplay.cjs",
    "test:browser": "node tests/browser.cjs",
    "check:repo": "node scripts/check-repository.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:repo && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "blockly": "13.3.0",
    "lucide-react": "0.544.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.62.0",
    "prettier": "3.9.10",
    "typescript": "5.9.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
